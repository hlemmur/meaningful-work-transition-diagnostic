# Runtime. Keep PAYMENTS_ENABLED=false until the staging launch-gate checklist is green.
APP_MODE=mock
LLM_MODE=
PAYMENTS_ENABLED=false
RETENTION_DAYS=90
CRON_SECRET=

# Server-only vendor credentials. Never prefix these with NEXT_PUBLIC_.
# Lemon webhooks must send HMAC-SHA256 in x-signature; live mode requires
# LEMON_SQUEEZY_WEBHOOK_SECRET. Checkout stays gated by PAYMENTS_ENABLED.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_CHECKOUT_URL=
# Set LLM_MODE=live and GEMINI_API_KEY to call Google AI Studio while checkout stays mocked.
GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-2.5-flash
RESEND_API_KEY=
RESEND_FROM=

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lena admin allowlist (comma-separated). Live auth uses Supabase magic links.
ADMIN_EMAIL_ALLOWLIST=lena@example.com
APP_URL=
